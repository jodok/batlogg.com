---
import BaseLayout from "./BaseLayout.astro";
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import Categories from '../components/Categories.astro';
import CategoryIcon from '../components/CategoryIcon.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { getSocialImage, getSocialImageSource } from '../utils/social-image';

type Props = CollectionEntry<'posts'>['data'];

const { title, subtitle, description, categories, pubDate, updatedDate, heroImage, heroImageAlt, socialImagePosition, heroImagePosition, coAuthors } = Astro.props;
const primaryCategory = categories?.[0];
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const shareImage = heroImage;
const shareImageSource = getSocialImageSource(shareImage);
const optimizedShareImage = await getSocialImage(shareImage, socialImagePosition);
const imageURL = new URL(optimizedShareImage.src, Astro.url).toString();
const shareImageAlt = shareImageSource === shareImage ? heroImageAlt : 'Jodok Batlogg';
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      name: 'Jodok Batlogg',
      url: Astro.site?.toString(),
    },
    {
      '@type': 'WebSite',
      name: 'Jodok Batlogg',
      url: Astro.site?.toString(),
    },
    {
      '@type': 'Article',
      headline: title,
      name: title,
      description: description || subtitle || title,
      datePublished: pubDate.toISOString(),
      dateModified: (updatedDate || pubDate).toISOString(),
      author: {
        '@type': 'Person',
        name: 'Jodok Batlogg',
      },
      publisher: {
        '@type': 'Person',
        name: 'Jodok Batlogg',
      },
      ...(imageURL ? { image: imageURL } : {}),
      url: canonicalURL.toString(),
      mainEntityOfPage: canonicalURL.toString(),
    },
  ],
};
---

<BaseLayout
  title={title}
  description={description || subtitle || title}
  image={shareImage}
  imageAlt={shareImageAlt}
  imagePosition={socialImagePosition}
  ogType="article"
  jsonLd={jsonLd}
  >
  {heroImage && (
    <>
      <div class="w-full h-[270px] overflow-hidden">
        <Image
          width={1400}
          height={600}
          src={heroImage}
          alt={heroImageAlt || ''}
          class="w-full h-full object-cover"
          style={heroImagePosition ? { objectPosition: heroImagePosition } : undefined}
        />
      </div>
    </>
  )}

  <article class="max-w-[680px] mx-auto px-6 pt-6 pb-20">
    <div class:list={['mb-4', heroImage ? '-mt-12' : '']}>
      {primaryCategory ? (
        <a
          href={`/category/${encodeURIComponent(primaryCategory)}`}
          class="inline-flex h-12 w-12 items-center justify-center"
          aria-label={`Category: ${primaryCategory}`}
        >
          <CategoryIcon category={primaryCategory} variant="large" />
        </a>
      ) : (
        <span class="inline-flex h-12 w-12 items-center justify-center" aria-hidden="true">
          <CategoryIcon variant="large" />
        </span>
      )}
    </div>
    <header class="mb-8">
      <div class="mb-2">
        <span class="text-sm text-gray-500">
          <FormattedDate date={pubDate} />
          {updatedDate && (
              <span>, last updated on <FormattedDate date={updatedDate} /></span>
          )}
        </span>
      </div>
      <h1 class="text-4xl leading-tight md:text-4xl">{title}</h1>
      {subtitle && <p class="mt-2 text-3xl leading-tight text-gray-300 md:text-4xl">{subtitle}</p>}
      <div class="mt-5">
        <Categories categories={categories} />
      </div>
      {coAuthors && coAuthors.length > 0 && (
        <p class="mt-5 text-sm text-gray-500">
          Co-authored with{' '}
          {coAuthors.map((author, index) => (
            <>
              {index > 0 && (index === coAuthors.length - 1 ? ' and ' : ', ')}
              <a class="underline" href={author.url}>{author.name}</a>
            </>
          ))}
        </p>
      )}
    </header>

    <div class="post-content post-content-article">
      <slot />
    </div>

  </article>
</BaseLayout>
