---
import BaseLayout from '../layouts/BaseLayout.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { Image } from 'astro:assets';
import kitesurfingPhoto from '../assets/jodok-kitesurfing.jpg';
import { ORGANIZATION_SCHEMA } from '../consts';

const description = 'Jodok Batlogg — entrepreneur and engineer building where technology meets impact. Founder of Tree.ly (now Pina Earth) and co-founder of Crate.io (CrateDB), former StudiVZ engineering lead, based in Dornbirn, Austria.';
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    ORGANIZATION_SCHEMA,
    {
      '@type': 'WebSite',
      name: 'Jodok Batlogg',
      url: Astro.site?.toString(),
    },
    {
      '@type': 'WebPage',
      name: 'About | Jodok Batlogg',
      description,
      url: canonicalURL.toString(),
    },
    {
      '@type': 'Person',
      name: 'Jodok Batlogg',
      url: new URL('/about/', Astro.site).toString(),
      jobTitle: 'Entrepreneur & Engineer',
      description: 'Jodok Batlogg is a serial entrepreneur and engineer based in Dornbirn, Austria, building where technology meets impact. He is building something new connected to Here Be Dragons, founded the climate-tech company Tree.ly (now Pina Earth), founded Crate.io (CrateDB), and previously led engineering at StudiVZ and founded Lovely Systems.',
      homeLocation: {
        '@type': 'Place',
        name: 'Dornbirn, Austria',
      },
      worksFor: {
        '@type': 'Organization',
        name: 'Here Be Dragons',
        url: 'https://here-be-dragons.ai/',
      },
      alumniOf: [
        { '@type': 'Organization', name: 'Crate.io (CrateDB)' },
        { '@type': 'Organization', name: 'VZ Netzwerke (StudiVZ)' },
        { '@type': 'Organization', name: 'Lovely Systems' },
      ],
      knowsAbout: [
        'Climate technology',
        'Carbon removal',
        'Distributed databases',
        'Software engineering',
        'Entrepreneurship',
        'Leadership',
      ],
      sameAs: [
        'https://batlogg.com/',
        'https://here-be-dragons.ai/',
        'https://www.ted.com/talks/jodok_batlogg_saving_the_climate_with_entrepreneurship',
      ],
    },
  ],
};
---

<BaseLayout
  title="About"
  description={description}
  jsonLd={jsonLd}
  >
  <section class="max-w-[750px] mx-auto px-6 pt-28 pb-12">
    <p class="text-xs font-semibold uppercase tracking-tight text-[#8e5fa4]">About</p>
    <h1 class="mt-3 max-w-[38rem] text-4xl leading-tight md:text-5xl">
      Building between Kaos and Kosmos.
    </h1>

    <div class="mt-8 space-y-4">
      <p class="text-lg leading-relaxed text-gray-600">
        I've spent two decades building and leading companies across open source, distributed systems, climate technology, and impact. My work tends to live where ambitious technology meets messy real-world systems — with unruly optimism and both feet on the ground.
      </p>
      <p class="text-lg leading-relaxed text-gray-600">
        I'm based in the Alps near Dornbirn, Austria, where the mountains remind me daily that the best things are built with patience, persistence, and a healthy respect for nature. I'm a natural scientist by education, a long-time open-source contributor, and — for what it's worth — a beekeeper.
      </p>
    </div>

    <figure class="mt-10">
      <Image
        src={kitesurfingPhoto}
        alt="Jodok Batlogg at the beach after kitesurfing"
        width={1000}
        height={620}
        class="h-auto w-full object-cover"
        style={{ aspectRatio: '1000 / 620', objectPosition: '34% 38%' }}
      />
      <figcaption class="mt-3 text-sm leading-relaxed text-gray-500">
        Outside, preferably near, mountains, wind and water - most often with a smile.
      </figcaption>
    </figure>

    <div class="mt-8 border-l-2 border-[#8e5fa4] pl-5">
      <span class="mb-1 block text-xs font-semibold uppercase tracking-tight text-gray-600">Now</span>
      <p class="text-lg leading-relaxed text-gray-900">
        I'm building something new at the intersection of technology, AI, and trust, right now exploring in an experimental setup with <a href="https://here-be-dragons.ai/" target="_blank" rel="noreferrer" class="text-[#8e5fa4] hover:text-gray-900">Here Be Dragons</a>. Before that, I founded Tree.ly (now Pina Earth), making high-quality, nature-based carbon removal transparent and accessible, and a few more projects.
      </p>
    </div>

    <!-- Timeline -->
    <h2 class="mt-6 text-l font-semibold leading-[64px] text-gray-900 uppercase">Journey</h2>

    <div class ="text-xs text-gray-500 mt-5">
      2021 - 2026
    </div>
    <h3 class="mt-1 flex items-center gap-2 font-semibold text-gray-900">
      Founder & CEO, Tree.ly (now Pina Earth)
    </h3>
    <p class="text-gray-500 text-sm leading-relaxed">
      Building the infrastructure for trustworthy, nature-based carbon removal — making high-quality forest carbon transparent and accessible. Founded in 2021 as Tree.ly with data-driven forest climate projects, later becoming Pina Earth, leading a cross-functional team across forestry science, technology, and carbon markets.
    </p>

    <div class ="text-xs text-gray-500 mt-5">
      2013 - 2020
    </div>
    <h3 class="mt-1 flex items-center gap-2 font-semibold text-gray-900">
      Founder & CEO, later CTO, Crate.io (CrateDB)
    </h3>
    <p class="text-gray-500 text-sm leading-relaxed">
      Built a distributed SQL database from zero to millions of inserts per second. Grew the company past 60 people, raised a Series A and beyond, and flipped it to the US — obsessing over distributed systems and a strong engineering culture built on trust.
    </p>

    <div class ="text-xs text-gray-500 mt-5">
      2008 - 2010
    </div>
    <h3 class="mt-1 flex items-center gap-2 font-semibold text-gray-900">
      CTO & Managing Director, VZ Netzwerke (StudiVZ)
    </h3>
    <p class="text-gray-500 text-sm leading-relaxed">
      Led engineering and product for StudiVZ — the largest German-speaking website of its time. Re-architected the platform, scaled backend infrastructure, and managed the tech teams.
    </p>

    <div class ="text-xs text-gray-500 mt-5">
      2005 - 2008
    </div>
    <h3 class="mt-1 flex items-center gap-2 font-semibold text-gray-900">
      Founder, Lovely Systems
    </h3>
    <p class="text-gray-500 text-sm leading-relaxed">
      Early adopters of cloud computing, building distributed systems, search infrastructure, and user-generated-content platforms for media companies.
    </p>

    <div class ="text-xs text-gray-500 mt-5">
      Early 2000s
    </div>
    <h3 class="mt-1 flex items-center gap-2 font-semibold text-gray-900">
      Open-source developer & board member, Plone, Zope & Gentoo Linux
    </h3>
    <p class="text-gray-500 text-sm leading-relaxed">
      Active contributor to open-source projects, and director of the Plone and Zope foundations — advocating for open-source software and community-driven development.
    </p>


    <!-- Values / What I Care About -->
    <h2 class="mt-6 text-l font-semibold leading-[64px] text-gray-900 uppercase">What I care about</h2>
    <div class="grid md:grid-cols-3 gap-6">
      <div>
        <h3 class="mt-1 flex items-center gap-2 font-semibold text-gray-900">
          Sovereign Technology
        </h3>
        <p class="text-gray-500 text-sm leading-relaxed">
          Europe has a unique opportunity to build technology that is sovereign, trustworthy, and aligned with our values.
          We're between China and the US, and we need to build our own path — with open-source, privacy-respecting, and human-centered technology.
        </p>
      </div>

      <div>
        <h3 class="mt-1 flex items-center gap-2 font-semibold text-gray-900">
          Impact
        </h3>
        <p class="text-gray-500 text-sm leading-relaxed">
          Technology should serve the planet, not just shareholders. I'm obsessed with building things that make a real, measurable difference.
          Local models, running at a fraction of the energy cost of large language models, are a great example of how we can build technology that is both powerful and responsible.
        </p>
      </div>

      <div>
        <h3 class="mt-1 flex items-center gap-2 font-semibold text-gray-900">
          Engineering Excellence
        </h3>
        <p class="text-gray-500 text-sm leading-relaxed">
          Coming from software engineering, I know great software is a craft. I believe in clean code, thoughtful architecture, and the beauty of elegant solutions.
          Humans and Agents are the future of software, and I care deeply about building teams that can build great software together.
        </p>
      </div>

      <div>
        <h3 class="mt-1 flex items-center gap-2 font-semibold text-gray-900">
          Leadership & Self-organisation
        </h3>
        <p class="text-gray-500 text-sm leading-relaxed">
          My job is to make others great. I care deeply about the human side of things and commit to the agile values: courage, commitment, focus, openness, and respect.
        </p>
      </div>
    </div>

    <!-- Contact -->
    <section id="get-in-touch" class="mt-12 border-t border-gray-100 pt-10">
      <p class="text-xs font-semibold uppercase tracking-tight text-[#8e5fa4]">Get in touch</p>
      <h2 class="mt-3 max-w-[34rem] text-3xl leading-tight text-gray-900">
        Reach me directly, or let Tashi route it.
      </h2>
      <p class="mt-4 max-w-[36rem] text-lg leading-relaxed text-gray-600">
        Working on something at the intersection of technology, climate, and impact — or just want to say servus? Email is still best for thoughtful notes; Tashi can help with scheduling and routing.
      </p>

      <div class="mt-8 grid gap-4 md:grid-cols-2">
        <a href="mailto:jodok@batlogg.com" class="block border border-gray-200 p-5 transition-colors hover:bg-gray-50">
          <span class="text-xs font-semibold uppercase tracking-tight text-gray-500">Direct</span>
          <h3 class="mt-3 text-xl font-semibold text-gray-900">jodok@batlogg.com</h3>
          <p class="mt-2 text-sm leading-relaxed text-gray-500">For personal notes, ideas, and conversations that should not disappear in a feed.</p>
        </a>

        <div class="border border-[#8e5fa4] p-5">
          <span class="text-xs font-semibold uppercase tracking-tight text-[#8e5fa4]">Agent</span>
          <h3 class="mt-3 text-xl font-semibold text-gray-900">Call my agent</h3>
          <p class="mt-2 text-sm leading-relaxed text-gray-500">
            Tashi is my OpenClaw-based agent and can help with scheduling, routing, and triage.
          </p>
          <div class="mt-4 flex flex-wrap items-center gap-4">
            <a href="mailto:tashi@namche.ai" class="text-sm font-medium text-[#8e5fa4] hover:text-gray-900">tashi@namche.ai</a>
            <a href="https://t.me/+4367764049410" target="_blank" rel="noreferrer" class="inline-flex items-center gap-2 text-sm font-medium text-gray-500 hover:text-gray-900" aria-label="Message Tashi on Telegram">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M21.94 4.37 18.72 19.5c-.24 1.07-.87 1.33-1.76.83l-4.86-3.58-2.35 2.26c-.26.26-.48.48-.98.48l.35-4.95 9-8.13c.39-.35-.09-.55-.6-.2L6.4 13.22 1.6 11.72C.55 11.39.53 10.67 1.82 10.17L20.6 2.93c.87-.32 1.63.2 1.34 1.44Z"></path></svg>
              Telegram
            </a>
            <a href="https://wa.me/4367764049410" target="_blank" rel="noreferrer" class="inline-flex items-center gap-2 text-sm font-medium text-gray-500 hover:text-gray-900" aria-label="Message Tashi on WhatsApp">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.52 3.48A11.84 11.84 0 0 0 12.08 0C5.5 0 .15 5.35.15 11.93c0 2.1.55 4.15 1.6 5.96L.05 24l6.25-1.64a11.9 11.9 0 0 0 5.78 1.47h.01c6.58 0 11.93-5.35 11.93-11.93a11.85 11.85 0 0 0-3.5-8.42ZM12.09 21.8h-.01a9.9 9.9 0 0 1-5.04-1.38l-.36-.21-3.71.97.99-3.62-.23-.37a9.85 9.85 0 0 1-1.51-5.26c0-5.44 4.43-9.87 9.88-9.87a9.8 9.8 0 0 1 6.98 2.9 9.82 9.82 0 0 1 2.9 6.96c0 5.45-4.43 9.88-9.89 9.88Zm5.42-7.39c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.95 1.17-.17.2-.35.22-.64.07-.3-.15-1.25-.46-2.38-1.47a8.9 8.9 0 0 1-1.65-2.05c-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.18.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.61-.92-2.21-.24-.58-.49-.5-.67-.51l-.57-.01c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.48 0 1.46 1.07 2.87 1.22 3.07.15.2 2.1 3.21 5.09 4.5.71.31 1.27.49 1.7.63.71.23 1.36.2 1.87.12.57-.09 1.76-.72 2.01-1.41.25-.7.25-1.29.17-1.42-.07-.13-.27-.2-.57-.35Z"></path></svg>
              WhatsApp
            </a>
          </div>
        </div>
      </div>

      <div class="mt-8">
        <h3 class="text-sm font-semibold uppercase tracking-tight text-gray-900">Elsewhere</h3>
        <SocialLinks class="mt-4" />
      </div>
    </section>

  </section>
</BaseLayout>
