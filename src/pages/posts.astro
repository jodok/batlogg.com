---
import BaseLayout from '../layouts/BaseLayout.astro';
import CategoryFilters from '../components/CategoryFilters.astro';
import PostCard from '../components/PostCard.astro';
import { getPostCategories, getPublishedPosts } from '../utils/posts';

const posts = await getPublishedPosts();
const categories = getPostCategories(posts);
---

<BaseLayout
  title="Writing"
  description="Essays and notes by Jodok Batlogg on technology, climate, leadership, and building companies."
  >
  <section class="mx-auto max-w-[750px] px-6 pt-28 pb-20">
    <p class="text-xs font-semibold uppercase tracking-tight text-[#8e5fa4]">Writing</p>
    <h1 class="mt-3 max-w-[38rem] text-4xl leading-tight md:text-5xl">
      Notes from the field.
    </h1>
    <p class="mt-6 max-w-[36rem] text-lg leading-relaxed text-gray-600">
      Essays and field notes on technology, climate, leadership, company building, and the occasional detour.
    </p>

    <CategoryFilters categories={categories} totalCount={posts.length} />

    <div class="mt-8 space-y-2">
      {posts.map((post) => (
        <PostCard
          url={`/${post.id}/`}
          title={post.data.title}
          description={post.data.description}
          pubDate={post.data.pubDate}
          categories={post.data.categories}
        />
      ))}
    </div>
  </section>
</BaseLayout>
