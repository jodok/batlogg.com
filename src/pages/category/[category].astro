---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CategoryFilters from '../../components/CategoryFilters.astro';
import PostCard from '../../components/PostCard.astro';
import { getPostCategories, getPublishedPosts } from '../../utils/posts';

export async function getStaticPaths() {
  const allPosts = await getPublishedPosts();
  const categories = getPostCategories(allPosts);

  return categories.map((category) => ({
    params: { category: category.name },
  }));
}

const { category } = Astro.params;
const posts = await getPublishedPosts();
const categories = getPostCategories(posts);
const filteredPosts = posts.filter((post) =>
  !!category && post.data.categories?.includes(category)
);

---

<BaseLayout
  title={`${category} - Writing`}
  description={`Posts by Jodok Batlogg in the ${category} category.`}
>
  <section class="mx-auto max-w-[750px] px-6 pt-28 pb-20">
    <p class="text-xs font-semibold uppercase tracking-tight text-[#8e5fa4]">Writing</p>
    <h1 class="mt-3 max-w-[38rem] text-4xl leading-tight md:text-5xl">
      {category}
    </h1>
    <p class="mt-6 max-w-[36rem] text-lg leading-relaxed text-gray-600">
      Posts tagged <span class="font-medium text-gray-900">#{category}</span>, filtered from the full writing archive.
    </p>

    <CategoryFilters categories={categories} totalCount={posts.length} activeCategory={category} />

    <div class="mt-8 space-y-2">
      {filteredPosts.map((post) => (
        <PostCard
          url={`/${post.id}/`}
          title={post.data.title}
          description={post.data.description}
          pubDate={post.data.pubDate}
          categories={post.data.categories}
          heroImage={post.data.heroImage}
        />
      ))}
    </div>
  </section>
</BaseLayout>
